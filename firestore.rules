rules_version = '2';
// Règles de sécurité de La Piaule. À coller dans Firebase > Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isMe(uid) { return signed() && request.auth.uid == uid; }
    function owner() {
      return signed() && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }

    // Le premier compte connecté devient le créateur, et ça ne change plus.
    match /config/owner {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }

    match /comptes/{uid}   { allow read: if signed(); allow write: if isMe(uid); }
    match /presence/{uid}  { allow read: if signed(); allow write: if isMe(uid); }
    match /typing/{uid}    { allow read: if signed(); allow write: if isMe(uid); }
    match /profils/{uid}   { allow read: if signed(); allow write: if isMe(uid) || owner(); }

    // Réservé au créateur
    match /badges/{id}       { allow read: if signed(); allow write: if owner(); }
    match /attributions/{id} { allow read: if signed(); allow write: if owner(); }
    match /certifs/{id}      { allow read: if signed(); allow write: if owner(); }
    match /annonces/{id}     { allow read: if signed(); allow write: if owner(); }
    match /versions/{id}     { allow read: if signed(); allow write: if owner(); }

    // Chacun envoie ses signalements, seul le créateur les lit tous.
    match /signalements/{uid} { allow read, write: if isMe(uid) || owner(); }

    // Données privées de chaque membre (notes perso)
    match /data/users/{uid}/{rest=**} { allow read, write: if isMe(uid); }

    match /serveurs/{id} {
      allow read: if signed();
      allow create: if signed() && (request.resource.data.owner == request.auth.uid || owner());
      allow update: if signed();
      allow delete: if signed() && (resource.data.owner == request.auth.uid || owner());
    }
    match /salons/{id} { allow read, write: if signed(); }

    match /messages/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.author == request.auth.uid;
      allow update: if signed();
      allow delete: if signed() && (resource.data.author == request.auth.uid || owner());
    }

    match /dms/{id} {
      allow read, update: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.auth.uid in request.resource.data.members;
    }

    match /images/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.by == request.auth.uid;
      allow delete: if owner() || (signed() && resource.data.by == request.auth.uid);
    }
  }
}
